<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetOps Toolbox" Width="1360" Height="850" MinWidth="1050" MinHeight="660"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" FontSize="13" Foreground="#111827" Background="{DynamicResource WorkspaceBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="WorkspaceBrush" Color="#F6F8FA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D8DEE8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#4B5563"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#047857"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentOnWhiteBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentOnHighlightBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="WorkspaceTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="WorkspaceMutedBrush" Color="#4B5563"/>
        <SolidColorBrush x:Key="SelectedCellTextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#047857"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#92400E"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#B91C1C"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentOnWhiteBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="13,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="Navigation" TargetType="RadioButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavChrome" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2" CornerRadius="5,5,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource AccentBackgroundBrush}"/>
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentOnHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource AccentBackgroundBrush}"/>
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentOnHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="OutcomeText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Outcome}" Value="Success">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Hop reply">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Partial replies">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="No reply">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Timed out">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Refused">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Unreachable">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WorkspaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0" LastChildFill="True">
                <Button x:Name="AboutButton" DockPanel.Dock="Right" Style="{StaticResource Action}" VerticalAlignment="Center"
                        AutomationProperties.Name="About and support">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="About / Support" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border x:Name="DefaultLogo" DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="7"
                        Background="{DynamicResource AccentBackgroundBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE839;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentOnHighlightBrush}" FontSize="23" HorizontalAlignment="Center"/>
                </Border>
                <Image x:Name="CompanyLogo" DockPanel.Dock="Left" Width="132" Height="50" Stretch="Uniform"
                       Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="AppTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CompanyText" Style="{StaticResource Muted}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel x:Name="NavigationPanel" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                <RadioButton x:Name="HomeNav" GroupName="WorkspaceNavigation" Tag="Home" AutomationProperties.Name="Home" Style="{StaticResource Navigation}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Home"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ConnectivityNav" GroupName="WorkspaceNavigation" Tag="Connectivity" AutomationProperties.Name="Connectivity" Style="{StaticResource Navigation}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Connectivity"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LocalNav" GroupName="WorkspaceNavigation" Tag="Local" AutomationProperties.Name="Local Network" Style="{StaticResource Navigation}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Local Network"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ReportsNav" GroupName="WorkspaceNavigation" Tag="Reports" AutomationProperties.Name="Reports" Style="{StaticResource Navigation}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Reports"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="20,17,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="1,0,0,15">
                <TextBlock x:Name="PageTitle" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource WorkspaceTextBrush}"/>
                <TextBlock x:Name="PageSubtitle" Style="{StaticResource Muted}" Foreground="{DynamicResource WorkspaceMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" x:Name="HomePanel" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource Glyph}" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Quick check" Style="{StaticResource Heading}"/>
                        </StackPanel>
                        <TextBlock Text="Check the active adapter, IPv4 address, gateway, DNS, and internet reachability over ICMP and TCP."
                                   Style="{StaticResource Muted}" Margin="0,6,0,12"/>
                        <Button x:Name="QuickCheckButton" Content="Run quick check" Style="{StaticResource PrimaryAction}"
                                HorizontalAlignment="Left" IsDefault="True"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/>
                            <TextBlock Text="Common diagnostics" Style="{StaticResource Heading}"/>
                        </StackPanel>
                        <WrapPanel Margin="0,9,0,0">
                            <Button x:Name="ShortcutTcp" Content="TCP port" Tag="Tcp" Style="{StaticResource Action}" Margin="0,0,6,5"/>
                            <Button x:Name="ShortcutDns" Content="DNS lookup" Tag="Dns" Style="{StaticResource Action}" Margin="0,0,6,5"/>
                            <Button x:Name="ShortcutTrace" Content="Traceroute" Tag="Trace" Style="{StaticResource Action}" Margin="0,0,0,5"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" x:Name="WorkPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RailColumn" Width="0"/>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="3*" MinWidth="265" MaxWidth="325"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ToolRail" Style="{StaticResource Card}" Margin="0,0,12,0" Visibility="Collapsed">
                    <DockPanel Margin="10" LastChildFill="True">
                        <TextBlock Text="Diagnostics" Style="{StaticResource Heading}" DockPanel.Dock="Top" Margin="7,3,0,10"/>
                        <ListBox x:Name="ToolList" DisplayMemberPath="Name" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ListItem}"
                                 AutomationProperties.Name="Diagnostics"/>
                    </DockPanel>
                </Border>

                <Border x:Name="HistoryRail" Style="{StaticResource Card}" Margin="0,0,12,0" Visibility="Collapsed">
                    <DockPanel Margin="10" LastChildFill="True">
                        <TextBlock Text="Session history" Style="{StaticResource Heading}" DockPanel.Dock="Top" Margin="7,3,0,10"/>
                        <Button x:Name="ClearHistoryButton" DockPanel.Dock="Bottom" Margin="0,9,0,0" Content="Clear session history"
                                Style="{StaticResource Action}" IsEnabled="False"/>
                        <Grid>
                            <TextBlock x:Name="EmptyHistory" Text="Completed runs appear here." Style="{StaticResource Muted}" Margin="7,2,5,0"/>
                            <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ListItem}"
                                     AutomationProperties.Name="Session history">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding HistoryLabel}" Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="RunPanel" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="RunButton" DockPanel.Dock="Right" Content="Run diagnostic" Style="{StaticResource PrimaryAction}"
                                        Margin="10,0,0,0" VerticalAlignment="Top" IsDefault="True"/>
                                <StackPanel>
                                    <TextBlock x:Name="ToolTitle" Style="{StaticResource Heading}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ToolDescription" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid x:Name="InputsPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label x:Name="TargetLabel" Content="Hostname or IP address" Target="{Binding ElementName=TargetInput}"
                                           Padding="0,0,0,4" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TargetInput" Style="{StaticResource Field}" MaxLength="254"
                                             AutomationProperties.LabeledBy="{Binding ElementName=TargetLabel}"/>
                                </StackPanel>
                                <StackPanel x:Name="PortPanel" Grid.Column="1" Width="90" Margin="10,0,0,0" Visibility="Collapsed">
                                    <Label x:Name="PortLabel" Content="TCP port" Target="{Binding ElementName=PortInput}"
                                           Padding="0,0,0,4" FontWeight="SemiBold"/>
                                    <TextBox x:Name="PortInput" Style="{StaticResource Field}" MaxLength="7"
                                             AutomationProperties.LabeledBy="{Binding ElementName=PortLabel}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="InputError" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                                       Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="True" Margin="14,9">
                                <StackPanel x:Name="ExportPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                                            Margin="10,0,0,0" Visibility="Collapsed" IsEnabled="False">
                                    <Button x:Name="ExportJsonButton" Content="Export JSON" Style="{StaticResource Action}" Margin="0,0,6,0"/>
                                    <Button x:Name="ExportCsvButton" Content="Export CSV" Style="{StaticResource Action}"/>
                                </StackPanel>
                                <TextBlock x:Name="ResultCount" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12"
                                           Style="{StaticResource Muted}" TextWrapping="NoWrap"/>
                                <TextBlock x:Name="ResultTitle" Style="{StaticResource Heading}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                                          SelectionMode="Single" SelectionUnit="FullRow" BorderThickness="0,1,0,0"
                                          BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SurfaceBrush}"
                                          RowBackground="{StaticResource SurfaceBrush}" AlternatingRowBackground="#FAFBFD"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E9F1" RowHeight="32"
                                          AutomationProperties.Name="Diagnostic results">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F6F8FA"/>
                                            <Setter Property="Foreground" Value="#374151"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="10,0,6,0"/>
                                            <Setter Property="Height" Value="33"/>
                                            <Setter Property="BorderBrush" Value="#E5E9F1"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBackgroundBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectedCellTextBrush}"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="1.15*" MinWidth="92" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="1.05*" MinWidth="77" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="126" ElementStyle="{StaticResource OutcomeText}"/>
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="1.8*" MinWidth="100" ElementStyle="{StaticResource CellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel x:Name="ResultsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False" Margin="24,38,24,0" MaxWidth="300">
                                    <Border Width="40" Height="40" CornerRadius="7" HorizontalAlignment="Center"
                                            Background="{DynamicResource AccentBackgroundBrush}">
                                        <TextBlock Text="&#xE9F9;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentOnHighlightBrush}" HorizontalAlignment="Center" FontSize="20"/>
                                    </Border>
                                    <TextBlock x:Name="EmptyTitle" FontWeight="SemiBold" FontSize="14" TextAlignment="Center" Margin="0,9,0,4"/>
                                    <TextBlock x:Name="EmptyHint" TextAlignment="Center" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="12,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="14,13,14,11">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/>
                            <TextBlock Text="Result details" Style="{StaticResource Heading}"/>
                        </StackPanel>
                        <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                            <Grid Margin="14">
                                <TextBlock x:Name="DetailsEmpty" Text="Select a result to inspect its details." Style="{StaticResource Muted}"/>
                                <Grid x:Name="DetailsPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" MaxHeight="168"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock x:Name="DetailCheck" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="DetailTarget" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="DetailOutcome" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="DetailMessage" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <TextBox x:Name="DetailData" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                                             FontFamily="Consolas" FontSize="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             BorderBrush="{StaticResource LineBrush}" Padding="8" Background="#FAFBFD"
                                             AutomationProperties.Name="Structured result data"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="2" x:Name="SupportPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Application and runtime" Style="{StaticResource Heading}"/>
                            <TextBlock x:Name="ApplicationInfo" Style="{StaticResource Muted}" Margin="0,7,0,10"/>
                            <TextBlock x:Name="ConfigInfo" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LoggingInfo" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button x:Name="OpenReadmeButton" Content="Open README" Style="{StaticResource Action}" Margin="0,0,8,0"/>
                                <Button x:Name="OpenConfigButton" Content="Open configuration folder" Style="{StaticResource Action}" Margin="0,0,8,0"/>
                                <Button x:Name="OpenLogsButton" Content="Open logs" Style="{StaticResource Action}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Diagnostic traffic" Style="{StaticResource Heading}"/>
                            <TextBlock x:Name="ProbeInfo" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="ComputerText" FontSize="12" Style="{StaticResource Muted}" TextWrapping="NoWrap" Margin="0,0,16,0"/>
                    <TextBlock x:Name="PowerShellText" FontSize="12" Style="{StaticResource Muted}" TextWrapping="NoWrap"/>
                </StackPanel>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel diagnostic" Style="{StaticResource Action}"
                        MinHeight="25" Padding="8,1" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <ProgressBar x:Name="RunProgress" DockPanel.Dock="Right" Width="82" Height="5" IsIndeterminate="False"
                             Foreground="{DynamicResource AccentBrush}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Text="Ready." FontSize="12" Style="{StaticResource Muted}" TextWrapping="NoWrap"
                           TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
